{
  "crons": [
    {
      "path": "/api/cron/scrape",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/polish-watchdog",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/archive-landing-pages",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/sync-platform-aggregates",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/gsc-sync",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/advisor",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/content-maintenance",
      "schedule": "*/15 * * * *"
    }
  ],
  "functions": {
    "app/api/cron/content-maintenance/route.js": {
      "maxDuration": 300
    },
    "app/api/cron/scrape/route.js": {
      "maxDuration": 300
    },
    "app/api/cron/archive-landing-pages/route.js": {
      "maxDuration": 300
    },
    "app/api/admin/scraper/trigger/route.js": {
      "maxDuration": 300
    },
    "app/api/admin/scraper/continue/route.js": {
      "maxDuration": 300
    }
  }
}
