## EXISTING CODE PATTERNS (follow these exactly)

### Supabase REST API Pattern (`lib/supabase.js`)
```javascript
import { supaFetch, SUPABASE_URL, SUPABASE_ANON_KEY } from '@/lib/supabase';

// GET
const data = await supaFetch('/topics?map_id=eq.${mapId}&order=sort_order.asc');

// POST with return
const inserted = await supaFetch('/topics?select=id,title', {
  method: 'POST',
  headers: { Prefer: 'return=representation' },
  body: JSON.stringify(rowData),
});

// PATCH
await supaFetch(`/topics?id=eq.${id}`, {
  method: 'PATCH',
  headers: { Prefer: 'return=minimal' },
  body: JSON.stringify(updates),
});

// HEAD with count
const result = await supaFetch('/topics?select=id', { method: 'HEAD', headers: { Prefer: 'count=exact' } });
// result = { data: null, count: 123 }

// RPC call
const res = await fetch(`${SUPABASE_URL}/rest/v1/rpc/function_name`, {
  method: 'POST',
  headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${SUPABASE_ANON_KEY}`, apikey: SUPABASE_ANON_KEY },
  body: JSON.stringify({ param: value }),
});
```

### Admin Auth Pattern (`lib/admin-auth.js`)
```javascript
import { verifyAdmin, unauthorizedResponse } from '@/lib/admin-auth';

export async function GET(request) {
  try {
    verifyAdmin(request); // throws if unauthorized
    // ... handler logic
  } catch (error) {
    if (error.message.includes('Unauthorized')) return unauthorizedResponse();
    return Response.json({ error: error.message }, { status: 500 });
  }
}
```

### AI Model Call Pattern (`lib/ai-models.js`)
```javascript
import { callModel, extractJSON } from '@/lib/ai-models';

// Available models: 'claude-opus', 'claude-sonnet', 'gemini-flash', 'gemini-pro', 'gpt-4o'
// Automatic fallback chain: requested → claude-sonnet → claude-haiku

const result = await callModel('claude-opus', systemPrompt, userPrompt, {
  jsonMode: true,       // request JSON response
  maxTokens: 8192,      // default
  label: 'content-writer', // for logging
});
// result = { text, model, provider, usedFallback }

const parsed = extractJSON(result.text); // robust JSON parser with balanced braces
```

### SSE Streaming Pattern (from `app/api/admin/reviews/generate/route.js`)
```javascript
export const maxDuration = 300;

export async function POST(request) {
  verifyAdmin(request);
  const encoder = new TextEncoder();
  const stream = new ReadableStream({
    async start(controller) {
      const send = (data) => controller.enqueue(encoder.encode(`data: ${JSON.stringify(data)}\n\n`));
      try {
        send({ step: 'research', status: 'active', message: 'Researching sources...' });
        // ... do work
        send({ step: 'research', status: 'done' });
        send({ step: 'done', status: 'done', message: 'Complete!' });
      } catch (e) {
        send({ step: 'error', status: 'failed', message: e.message });
      }
      controller.close();
    },
  });
  return new Response(stream, { headers: { 'Content-Type': 'text/event-stream', 'Cache-Control': 'no-cache', Connection: 'keep-alive' } });
}
```

### Admin Page Pattern (client component with auth)
```javascript
'use client';
import { useAdmin } from '@/lib/admin-context';
import { useState, useEffect, useCallback } from 'react';

export default function MyAdminPage() {
  const { token } = useAdmin();
  const [data, setData] = useState(null);
  const [loading, setLoading] = useState(true);

  const fetchData = useCallback(async () => {
    if (!token) return;
    const res = await fetch('/api/admin/my-endpoint', {
      headers: { Authorization: `Bearer ${token}` },
    });
    if (res.ok) setData(await res.json());
    setLoading(false);
  }, [token]);

  useEffect(() => { fetchData(); }, [fetchData]);

  if (loading) return <div className="text-gray-500">Loading...</div>;

  return (
    <div>
      {/* Dark theme: bg-gray-900/50, border-gray-800/60, text-white/gray-400 */}
    </div>
  );
}
```

