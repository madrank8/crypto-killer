### Public Page Pattern (ISR with Supabase fetch)
```javascript
import { supaFetch } from '@/lib/supabase';

export const revalidate = 60;
export const dynamicParams = true;

export async function generateStaticParams() {
  const items = await supaFetch('/content?status=eq.published&select=slug');
  return (items || []).map(item => ({ slug: item.slug }));
}

export async function generateMetadata({ params }) {
  const { slug } = await params;
  const rows = await supaFetch(`/content?slug=eq.${slug}&status=eq.published&select=title,meta_description&limit=1`);
  const item = rows?.[0];
  if (!item) return { title: 'Not Found' };
  return { title: item.title, description: item.meta_description };
}

export default async function Page({ params }) {
  const { slug } = await params;
  // ... fetch and render
}
```

