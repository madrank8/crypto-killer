# Crypto Killer — environment variables (names only, set real values in
# .env.local and in Vercel → Settings → Environment Variables)

# ── Topical Map v2 pipeline ──────────────────────────────────────────
# DataForSEO (REQUIRED for map generation — no fabrication fallback).
# Plain login + password from app.dataforseo.com → API Access.
# NOT the Base64 string — the app builds the Basic auth header itself.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Ahrefs API v3 (optional enhancement layer: matching-terms expansion,
# parent topic, traffic potential, SERP authority). From ahrefs.com →
# Account settings → API keys.
AHREFS_API_KEY=
